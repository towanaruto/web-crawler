# ── Local dev (docker compose --profile local-db up) ──────────
DB_HOST=db
DB_PORT=5432
DB_NAME=web_crawler
DB_USER=myuser
DB_PASSWORD=mypassword

# ── Neon PostgreSQL (production) ──────────────────────────────
# Pooled endpoint for runtime queries from Next.js / crawler:
# DATABASE_URL=postgresql://user:pass@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct endpoint for Alembic migrations (no pgbouncer):
# MIGRATION_DATABASE_URL=postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# DB_REQUIRE_SSL=true

# ── Backend API (frontend Server Actions -> FastAPI) ──────────
BACKEND_API_URL=http://backend:8000
BACKEND_API_TOKEN=replace-with-a-long-random-shared-secret

# ── Auth0 (Vercel frontend) ───────────────────────────────────
# AUTH0_SECRET=use-openssl-rand-hex-32
# APP_BASE_URL=http://localhost:3000
# AUTH0_DOMAIN=https://your-tenant.region.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=
# AUTH0_SCOPE=openid profile email

# ── Invite/access-code controls ───────────────────────────────
INVITE_CODE_PEPPER=replace-with-a-long-random-pepper
AUTH0_BOOTSTRAP_SUB=auth0|replace-with-initial-admin-sub
BOOTSTRAP_USER_EMAIL=admin@example.com

# ── Cloudflare R2 (raw_html + image binaries) ─────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=web-crawler
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
